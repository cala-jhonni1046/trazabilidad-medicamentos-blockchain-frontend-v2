{
  "name": "medichain-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "api:descargar": "node scripts/api-descargar.mjs",
    "api:generar": "ng-openapi-gen --config ng-openapi-gen.json",
    "api:verificar": "node scripts/api-verificar.mjs",
    "postinstall": "npm run api:generar",
    "prestart": "npm run api:generar",
    "prebuild": "npm run api:generar",
    "prewatch": "npm run api:generar",
    "pretest": "npm run api:generar",
    "e2e": "playwright test",
    "e2e:lectura": "playwright test e2e/lectura",
    "e2e:tipos": "tsc -p e2e/tsconfig.json",
    "e2e:flujo": "playwright test e2e/flujo"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "barcode-detector": "3.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "0.48.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
